{
  "name": "ftc-buzz-simulator",
  "private": true,
  "version": "0.4.0",
  "description": "Buzz Simulator — simulador de FTC BIOBUZZ no navegador, offline e gratuito.",
  "author": "Lucas Hochmann Rosa (https://github.com/contatolucashrosa-bit)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "java:libs": "node scripts/build-java-libs.mjs",
    "java:patch-classlib": "node scripts/patch-teavm-classlib.mjs",
    "cad:convert": "node --max-old-space-size=12288 scripts/step-to-glb.mjs",
    "field:parts": "node scripts/arena-parts.mjs cad/arena cad/arena-parts",
    "field:models": "blender -b --python scripts/blender/build_field.py -- cad/arena-parts public/models/field",
    "sounds:ftclive": "node scripts/ftclive-sounds.mjs",
    "robots:models": "blender -b --python scripts/blender/build_robots.py -- cad/robots public/models/robots"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource/roboto": "^5.3.0",
    "fflate": "^0.8.3",
    "occt-import-js": "^0.0.23",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
